{
  "redirects": [
    {
      "source": "/fix-copy-paste",
      "destination": "https://www.textcase.in/fix-copy-paste-text",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "textcase.in"
        }
      ],
      "destination": "https://www.textcase.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
